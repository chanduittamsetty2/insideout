# Copy to .env.local and fill in. Without these, the app runs in demo mode (data stays in your browser).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser or commit it.
SUPABASE_SECRET_KEY=
# Postgres password, used only for running migrations.
SUPABASE_DB_PASSWORD=

# Google Cloud → APIs & Services → Credentials (restrict to "Places API (New)")
GOOGLE_PLACES_API_KEY=
